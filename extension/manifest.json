{
  "manifest_version": 3,
  "name": "Auto-Pearson",
  "version": "0.3.0",
  "description": "Frame-aware Pearson MyLab helper with visible question diagnostics, math validation, and optional screenshot context.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.pearson.com/*",
    "https://*.pearsoncmg.com/*",
    "https://*.mathxl.com/*",
    "https://*.mylabmastering.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pearson.com/*",
        "https://*.pearsoncmg.com/*",
        "https://*.mathxl.com/*",
        "https://*.mylabmastering.com/*"
      ],
      "js": [
        "answer-utils.js",
        "math.js",
        "pearson.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "assistant.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
