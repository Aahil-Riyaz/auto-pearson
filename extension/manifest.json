{
  "manifest_version": 3,
  "name": "Auto-Pearson (Experimental)",
  "version": "0.1.0",
  "description": "Experimental, opt-in AI-assisted workflow for Pearson MyLab homework questions.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://*.pearson.com/*",
    "https://*.pearsoncmg.com/*",
    "https://*.mathxl.com/*",
    "https://*.mylabmastering.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://api.github.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://*.pearson.com/*",
        "https://*.pearsoncmg.com/*",
        "https://*.mathxl.com/*",
        "https://*.mylabmastering.com/*"
      ],
      "js": ["answer-utils.js", "pearson.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://gemini.google.com/*", "https://chat.deepseek.com/*"],
      "js": ["assistant.js"],
      "run_at": "document_idle"
    }
  ]
}
